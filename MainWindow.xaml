<Window x:Class="SoundFluent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SoundFluent.Ui"
        Title="Sound Fluent"
        Height="400" Width="360"
        MinHeight="400" MinWidth="360"
        MaxHeight="540" MaxWidth="420"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource Paper}" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="60" ShadowDepth="18" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="SoundFluent"
                           Margin="16,0,0,0" VerticalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}"
                            ToolTip="Settings" Content="&#xE713;" Click="OnSettingsGearClick"/>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}"
                            ToolTip="Hide" Content="&#xE8BB;" FontSize="10" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>

            <!-- Settings panel -->
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ui:SmoothScroll.IsEnabled="True"
                          Padding="16,2,16,16">
                <StackPanel>
                    <TextBlock Text="SETTINGS" FontFamily="Segoe UI" FontSize="11"
                               Foreground="{StaticResource InkMuted}"
                               Margin="0,0,0,12"/>

                    <!-- Model -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Model" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Used to turn every input into natural Polish" FontFamily="Segoe UI"
                                       FontSize="11" Foreground="{StaticResource InkMuted}"
                                       TextWrapping="Wrap" Margin="0,1,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="ModelPicker" Grid.Column="1" Style="{StaticResource SettingsCombo}"
                                  Width="140" IsEditable="True"
                                  SelectionChanged="OnModelSelectionChanged" LostFocus="OnModelLostFocus">
                            <ComboBoxItem Content="gpt-5"/>
                            <ComboBoxItem Content="gpt-5-mini"/>
                            <ComboBoxItem Content="gpt-4.1"/>
                        </ComboBox>
                    </Grid>
                    <Border Height="1" Background="{StaticResource PaperEdge}" Opacity="0.5" Margin="0,0,0,14"/>

                    <!-- Hotkey -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Hotkey" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Opens the window with the clipboard" FontFamily="Segoe UI"
                                       FontSize="11" Foreground="{StaticResource InkMuted}"
                                       TextWrapping="Wrap" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Style="{StaticResource KbdChip}">
                                <TextBlock Text="Ctrl" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource Ink}"/>
                            </Border>
                            <Border Style="{StaticResource KbdChip}">
                                <TextBlock Text="Alt" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource Ink}"/>
                            </Border>
                            <Border Style="{StaticResource KbdChip}" Margin="0">
                                <TextBlock Text="P" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource Ink}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource PaperEdge}" Opacity="0.5" Margin="0,0,0,14"/>

                    <!-- Copy the fix automatically -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Copy the fix automatically" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="The corrected text is on the clipboard the moment it lands"
                                       FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource InkMuted}"
                                       TextWrapping="Wrap" Margin="0,1,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="AutoCopyToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                      VerticalAlignment="Center" Click="OnAutoCopyToggled"/>
                    </Grid>

                    <!-- Send on open -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Send on open" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Off lets you edit the clipboard first" FontFamily="Segoe UI"
                                       FontSize="11" Foreground="{StaticResource InkMuted}"
                                       TextWrapping="Wrap" Margin="0,1,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="AutoSendToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                      VerticalAlignment="Center" Click="OnAutoSendToggled"/>
                    </Grid>

                    <!-- Always on top -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Always on top" FontFamily="Segoe UI" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Stays above the window you were writing in" FontFamily="Segoe UI"
                                       FontSize="11" Foreground="{StaticResource InkMuted}"
                                       TextWrapping="Wrap" Margin="0,1,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="OnTopToggle" Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                      VerticalAlignment="Center" Click="OnAlwaysOnTopToggled"/>
                    </Grid>

                    <Button Content="Done" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Click="OnSettingsDoneClick"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Chat panel -->
            <Grid x:Name="ChatPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="Transcript" Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ui:SmoothScroll.IsEnabled="True"
                              Padding="16,2,16,4">
                    <StackPanel x:Name="Messages"/>
                </ScrollViewer>

                <Border Grid.Row="1" Padding="16,8,16,16">
                    <!-- Keep the primary action beside the input so the composer
                         uses a single compact row. -->
                    <Grid Margin="0,0,7,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InputBox" Grid.Column="0"
                                 Style="{StaticResource InputStyle}"
                                 Height="40" MinHeight="40" MaxHeight="132"
                                 TextChanged="OnInputTextChanged"
                                 SizeChanged="OnInputSizeChanged"
                                 PreviewKeyDown="OnInputKeyDown"/>

                        <Button x:Name="SendButton" Grid.Column="1"
                                Width="34" Height="34" Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource Accent}"
                                Foreground="White" Cursor="Hand"
                                ToolTip="Polish" Click="OnSendClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Circle"
                                            Width="{TemplateBinding Width}"
                                            Height="{TemplateBinding Height}"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="17">
                                        <Path Data="M 17,25 L 17,9 M 11,15 L 17,9 L 23,15"
                                              Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Circle" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Circle" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Transparent frameless windows do not receive WPF's native resize
                 behavior, so these thumbs resize the window directly. -->
            <Thumb Grid.RowSpan="2" Tag="Top" Height="6"
                   VerticalAlignment="Top" Cursor="SizeNS" Opacity="0"
                   DragDelta="OnResizeDragDelta" Panel.ZIndex="20"/>
            <Thumb Grid.RowSpan="2" Tag="Bottom" Height="6"
                   VerticalAlignment="Bottom" Cursor="SizeNS" Opacity="0"
                   DragDelta="OnResizeDragDelta" Panel.ZIndex="20"/>
            <Thumb Grid.RowSpan="2" Tag="Left" Width="6"
                   HorizontalAlignment="Left" Cursor="SizeWE" Opacity="0"
                   DragDelta="OnResizeDragDelta" Panel.ZIndex="20"/>
            <Thumb Grid.RowSpan="2" Tag="Right" Width="6"
                   HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0"
                   DragDelta="OnResizeDragDelta" Panel.ZIndex="20"/>

            <Thumb Grid.RowSpan="2" Tag="TopLeft" Width="12" Height="12"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Cursor="SizeNWSE" Opacity="0"
                   DragDelta="OnResizeDragDelta" Panel.ZIndex="21"/>
            <Thumb Grid.RowSpan="2" Tag="TopRight" Width="12" Height="12"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Cursor="SizeNESW" Opacity="0"
                   DragDelta="OnResizeDragDelta" Panel.ZIndex="21"/>
            <Thumb Grid.RowSpan="2" Tag="BottomLeft" Width="12" Height="12"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Cursor="SizeNESW" Opacity="0"
                   DragDelta="OnResizeDragDelta" Panel.ZIndex="21"/>

            <Thumb Grid.RowSpan="2" Tag="BottomRight" Width="18" Height="18"
                   Margin="0,0,3,3"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" DragDelta="OnResizeDragDelta"
                   Panel.ZIndex="21">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 5,14 L 14,5 M 9,14 L 14,9"
                                  Stroke="{StaticResource InkMuted}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
