<Window x:Class="SoundFluent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Fluent"
        Height="620" Width="470"
        MinHeight="360" MinWidth="380"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{StaticResource Paper}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Transcript -->
        <ScrollViewer x:Name="Transcript" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,14,16,4">
            <StackPanel x:Name="Messages"/>
        </ScrollViewer>

        <!-- Composer -->
        <Border Grid.Row="1" Background="{StaticResource Paper}"
                BorderBrush="{StaticResource PaperEdge}" BorderThickness="0,1,0,0"
                Padding="16,12,16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox x:Name="ModePicker"
                              Style="{StaticResource RegisterBox}"
                              Width="140" SelectedIndex="0"
                              SelectionChanged="OnModeChanged">
                        <ComboBoxItem Content="Check my Polish"/>
                        <ComboBoxItem Content="Translate to Polish"/>
                    </ComboBox>

                    <ComboBox x:Name="RegisterPicker"
                              Style="{StaticResource RegisterBox}"
                              Width="140" SelectedIndex="0"
                              Margin="8,0,0,0">
                        <ComboBoxItem Content="Keep my register"/>
                        <ComboBoxItem Content="Informal (ty)"/>
                        <ComboBoxItem Content="Formal (pan/pani)"/>
                    </ComboBox>
                </StackPanel>

                <TextBox x:Name="InputBox" Grid.Row="1"
                         Style="{StaticResource InputStyle}"
                         MinHeight="62" MaxHeight="150"
                         PreviewKeyDown="OnInputKeyDown"/>

                <Grid Grid.Row="2" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusLine" Grid.Column="0"
                               Margin="1,0,12,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource InkMuted}"/>

                    <Button x:Name="SendButton" Grid.Column="1"
                            Style="{StaticResource PrimaryButton}"
                            Content="Check  ⏎"
                            Click="OnSendClick"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
